<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<!--
  Installing a converted package is exactly as privileged as running
  `sudo dnf install`: the payload lands as root-owned files anywhere
  under /usr, so a package could drop a setuid binary.

  Every mode is therefore auth_admin. None of them may be relaxed to
  unconditional permission. That is not a hypothetical: it is
  CVE-2026-41651, where a permissive PackageKit polkit rule let any
  local user install an arbitrary RPM without a password, and the %post
  scriptlet then ran as root.

  Both the test suite and the package build check that every mode here
  still requires authentication, so this comment deliberately avoids
  spelling out the permissive value.

  auth_admin rather than auth_admin_keep: the authorisation is not
  cached, so each install is approved individually. Installing software
  is infrequent enough that the extra prompt costs little and the
  cached-authorisation window is worth more than it saves.
-->
<policyconfig>

  <vendor>debfed</vendor>
  <vendor_url>https://github.com/Marvin1198/debfed</vendor_url>

  <action id="com.github.debfed.install-rpm">
    <description>Install a converted Debian package</description>
    <description xml:lang="en_GB">Install a converted Debian package</description>
    <message>Authentication is required to install this package</message>
    <message xml:lang="en_GB">Authentication is required to install this package</message>

    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/debfed-install</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
