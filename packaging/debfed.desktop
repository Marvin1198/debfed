[Desktop Entry]
Type=Application
Version=1.0
Name=Install with debfed
GenericName=Debian Package Installer
Comment=Convert a Debian package to an RPM and install it
Keywords=deb;debian;package;install;convert;

# %f, not %F: one package at a time. Each conversion prints its own
# transaction preview, and batching them would mean approving several
# installs from a single prompt.
Exec=debfed gui-install %f
TryExec=debfed

Icon=system-software-install
Categories=System;

# application/vnd.debian.binary-package is the IANA-registered type and is
# already known to shared-mime-info, so no private MIME definition is
# needed. x-deb and x-debian-package are legacy aliases still emitted by
# some browsers and download tools.
MimeType=application/vnd.debian.binary-package;application/x-deb;application/x-debian-package;

# No terminal: gui-install converts as the calling user, shows the full
# report in a dialog, and escalates exactly once through pkexec, which
# presents the system's own authentication prompt.
#
# The preview is still shown before anything is installed -- that is the
# core safety property of this tool and is not traded away for
# convenience. What changed is only where it is displayed.
#
# debfed never handles a password. pkexec reports authorised or not.
Terminal=false

# Without this the first dialog opens unfocused and hidden behind the
# file manager. On Wayland a window may only take focus if it presents an
# xdg_activation_v1 token, and the launcher mints that token for the
# child process only when the entry asks for startup notification. With
# no token a genuine focus-steal is impossible and the window degrades to
# an attention request -- a taskbar highlight the user has to hunt for.
StartupNotify=true

# A file handler, not something to launch on its own. Without this it
# appears in the applications grid and does nothing useful when clicked.
NoDisplay=true
