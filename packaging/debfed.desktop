[Desktop Entry]
Type=Application
Version=1.0
Name=Install with debfed
GenericName=Debian Package Installer
Comment=Convert a Debian package to an RPM and install it
Keywords=deb;debian;package;install;convert;

# %f, not %F: one package at a time. Each conversion prints its own
# transaction preview, and batching them would mean approving several
# installs from a single prompt.
Exec=debfed install %f
TryExec=debfed

Icon=system-software-install
Categories=System;

# application/vnd.debian.binary-package is the IANA-registered type and is
# already known to shared-mime-info, so no private MIME definition is
# needed. x-deb and x-debian-package are legacy aliases still emitted by
# some browsers and download tools.
MimeType=application/vnd.debian.binary-package;application/x-deb;application/x-debian-package;

# Terminal=true is a deliberate security decision, not a shortcut.
#
# The alternative is a polkit policy, and a rule permitting "install this
# .deb" without authentication would be a local privilege escalation by
# design: debfed never runs maintainer scripts, but the payload still
# lands as root-owned files under /usr, so any local user could craft a
# package that drops a setuid binary.
#
# Running in a terminal means the escalation is ordinary sudo, with no
# new privileged component, and the user reads the dnf transaction
# preview before approving it. That preview is the core safety property
# of this tool; hiding it behind a graphical "Install" button would
# remove the one thing that makes converting a foreign package
# defensible.
Terminal=true

# A file handler, not something to launch on its own. Without this it
# appears in the applications grid and does nothing useful when clicked.
NoDisplay=true
